{
  "name": "ai-dispatcher",
  "version": "1.1.0",
  "description": "AI Development Control Plane - routes coding tasks between Claude Code, Codex, and local models (Ollama/llama.cpp), validates results with real build/test/lint, and cross-reviews with an independent AI before declaring success.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "ai-dispatcher": "dist/cli.js",
    "harness": "dist/harness-cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node dist/cli.js doctor"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "js-yaml": "^5.3.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@vscode/windows-process-tree": "0.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
